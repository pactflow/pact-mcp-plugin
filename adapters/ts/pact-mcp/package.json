{
  "name": "@pactflow/pact-mcp-plugin",
  "version": "0.3.0",
  "description": "Pact contract testing for Model Context Protocol (MCP) servers and clients. Ships an ergonomic TypeScript consumer/provider DX and provisions the Rust matching engine (the Pact `mcp` plugin) on install.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mefellows/pact-mcp-plugin.git",
    "directory": "adapters/ts/pact-mcp"
  },
  "homepage": "https://github.com/mefellows/pact-mcp-plugin#readme",
  "bugs": "https://github.com/mefellows/pact-mcp-plugin/issues",
  "keywords": [
    "pact",
    "mcp",
    "model-context-protocol",
    "contract-testing",
    "pactflow",
    "bdct"
  ],
  "bin": {
    "pact-mcp-install": "scripts/install-engine.cjs"
  },
  "files": [
    "dist",
    "scripts/install-engine.cjs"
  ],
  "engineConfig": {
    "repo": "mefellows/pact-mcp-plugin"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/install-engine.cjs || true",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pact-foundation/pact": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
